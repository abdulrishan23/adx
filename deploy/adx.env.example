# ADX server environment. Copy to /etc/adx/adx.env, chmod 600, owned by root,
# and fill the blanks. Never commit a filled copy. Secrets go in files the adx
# user alone can read; the variables below only point at them.

# "dev" hands every request an admin and only listens on localhost. Leave it
# unset (production) on a server.
# ADX_ENV=dev

ADX_ADDR=127.0.0.1:8080

# Persistent state. These directories must exist before the server starts;
# production refuses to create them so an unmounted volume is a loud failure.
ADX_DB_PATH=/var/lib/adx/data/adx.db
ADX_ASSETS_DIR=/var/lib/adx/data/assets

# 32 random bytes that seal provider credentials. Back it up separately from
# the database; without it a restored database has no usable connections.
ADX_CONNECTION_KEY_FILE=/etc/adx/connections.key

# Optional. GoHighLevel Marketplace OAuth credentials (JSON: client_id,
# client_secret, redirect_uri, version_id). Private tokens work without it.
# ADX_GHL_CREDENTIALS_FILE=/etc/adx/ghl-oauth.json

# Ad platforms (optional; connecting a platform is disabled without them).
# The callback is ADX_PUBLIC_URL + /api/connections/<provider>/callback.
# Google: an OAuth client in the Google Cloud project whose Google Ads API
# access level has been granted (developer tokens are sunset). The login
# customer id is the manager account, digits only, when access goes
# through one.
# ADX_GOOGLE_OAUTH_CLIENT_ID=
# ADX_GOOGLE_OAUTH_CLIENT_SECRET=
# ADX_GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Meta: a Business app; people who connect need a role on it (D-22).
# ADX_META_APP_ID=
# ADX_META_APP_SECRET=
# How many trailing days the daily refresh re-reads (platforms revise them).
ADX_ADS_REFRESH_TRAILING_DAYS=30

# Report delivery (optional). Without a host, reports are generated and shown
# in the app but never sent. D-24: a shared sender is still to be set up.
# ADX_SMTP_HOST=
# ADX_SMTP_PORT=587
# ADX_SMTP_USERNAME=
# ADX_SMTP_PASSWORD=
# ADX_SMTP_FROM="ADX <noreply@example.com>"

# Outreach channels. Both adapters are wired only with ADX_LIVE_WRITES=1, and
# a draft is sent only when the outreach config turns the channel on and a
# person approved it. WhatsApp Cloud sends plain text inside Meta's 24-hour
# window; the email channel reuses the SMTP relay above.
# ADX_WHATSAPP_ACCESS_TOKEN=
# ADX_WHATSAPP_PHONE_NUMBER_ID=
# ADX_OUTREACH_EMAIL_SUBJECT="A note from your sales team"

# Ask ADX model (optional). Without a key the assistant says it is not
# configured. Prices are per million tokens in micro-units of the billing
# currency, for cost accounting; unset means cost is shown as not available.
# ADX_MODEL_PROVIDER=anthropic
# ADX_MODEL_API_KEY=
# ADX_MODEL_NAME=claude-opus-5-5
# ADX_MODEL_EFFORT=medium
# ADX_MODEL_TIMEOUT_SECONDS=120
# ADX_ASSISTANT_DAILY_TOKEN_BUDGET=2000000
# ADX_MODEL_INPUT_PRICE_MICROS=4000000
# ADX_MODEL_OUTPUT_PRICE_MICROS=20000000
# Server-wide daily token cap across every model consumer (assistant, plans,
# research, call readings, workflows). Reached, every call is refused until
# the UTC day turns. 0 disables the cap; the default is ten million tokens.
# ADX_MODEL_DAILY_TOKEN_CAP=10000000

# First admin, linked by email on an empty install only.
ADX_BOOTSTRAP_ADMIN=

# authentik: who people are. All four are required outside dev.
ADX_AUTHENTIK_ISSUER=https://authentik.example/application/o/adx-auth/
ADX_AUTHENTIK_API_TOKEN=
ADX_AUTHENTIK_GROUP_ID=
ADX_AUTHENTIK_EMAIL_STAGE_ID=

# Sign-in over OpenID Connect against the `adx-auth` provider (D-24).
# The callback is ADX_PUBLIC_URL + /api/auth/callback; register exactly that
# redirect URI on the provider. The group name is the one in the groups claim.
ADX_PUBLIC_URL=https://adx.example.com
ADX_OIDC_CLIENT_ID=
ADX_OIDC_CLIENT_SECRET=
ADX_AUTHENTIK_GROUP_NAME=adx-users

# Ad-account writes. Off by default: execution intents are held in the outbox
# and nothing is sent to Google Ads or Meta. Set to 1 only with a written
# go-ahead, an account enabled for writes in Policies, and a test account.
ADX_LIVE_WRITES=0

# Backups: `adx backup DEST` prunes directories older than this many days
# after a new backup succeeded. 0 keeps everything.
# ADX_BACKUP_RETENTION_DAYS=0

# Inbound webhooks. GoHighLevel's webhook action must send this value in the
# X-ADX-Webhook-Secret header to POST /webhooks/ghl. Empty keeps the adapter
# off: it answers 503 and records nothing.
ADX_WEBHOOK_SECRET=

# Telephony. Empty places no call. "twilio" wires the reference adapter; the
# calling policy in the app must also name twilio as the route, with who
# authorized it and when, before any call is placed. The UAE route is not
# chosen; Twilio is a reference transport, not a decision.
ADX_TELECOM_ROUTE=
ADX_TWILIO_ACCOUNT_SID=
ADX_TWILIO_AUTH_TOKEN=

# Speech engine for qualification calls (ElevenLabs Conversational AI). The
# agent's audio format must be ulaw_8000 in and out; ADX refuses anything
# else at the handshake. Ambience gain mixes a generated room tone under the
# agent (0 = off, 0.2 = soft).
ADX_ELEVENLABS_API_KEY=
ADX_ELEVENLABS_AGENT_ID=
ADX_VOICE_AMBIENCE_GAIN=0
