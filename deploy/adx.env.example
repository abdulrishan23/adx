# ADX server environment. Copy to /etc/adx/adx.env, chmod 600, owned by root,
# and fill the blanks. Never commit a filled copy. Secrets go in files the adx
# user alone can read; the variables below only point at them.

# "dev" hands every request an admin and only listens on localhost. Leave it
# unset (production) on a server.
# ADX_ENV=dev

ADX_ADDR=127.0.0.1:8080

# Persistent state. These directories must exist before the server starts;
# production refuses to create them so an unmounted volume is a loud failure.
ADX_DB_PATH=/var/lib/adx/data/adx.db
ADX_ASSETS_DIR=/var/lib/adx/data/assets

# 32 random bytes that seal provider credentials. Back it up separately from
# the database; without it a restored database has no usable connections.
ADX_CONNECTION_KEY_FILE=/etc/adx/connections.key

# Optional. GoHighLevel Marketplace OAuth credentials (JSON: client_id,
# client_secret, redirect_uri, version_id). Private tokens work without it.
# ADX_GHL_CREDENTIALS_FILE=/etc/adx/ghl-oauth.json

# Ad platforms (optional; connecting a platform is disabled without them).
# The callback is ADX_PUBLIC_URL + /api/connections/<provider>/callback.
# Google: an OAuth client in the Google Cloud project whose Google Ads API
# access level has been granted (developer tokens are sunset). The login
# customer id is the manager account, digits only, when access goes
# through one.
# ADX_GOOGLE_OAUTH_CLIENT_ID=
# ADX_GOOGLE_OAUTH_CLIENT_SECRET=
# ADX_GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Meta: a Business app; people who connect need a role on it (D-22).
# ADX_META_APP_ID=
# ADX_META_APP_SECRET=
# How many trailing days the daily refresh re-reads (platforms revise them).
ADX_ADS_REFRESH_TRAILING_DAYS=30

# First admin, linked by email on an empty install only.
ADX_BOOTSTRAP_ADMIN=

# authentik: who people are. All four are required outside dev.
ADX_AUTHENTIK_ISSUER=https://authentik.example/application/o/adx-auth/
ADX_AUTHENTIK_API_TOKEN=
ADX_AUTHENTIK_GROUP_ID=
ADX_AUTHENTIK_EMAIL_STAGE_ID=

# Sign-in over OpenID Connect against the `adx-auth` provider (D-24).
# The callback is ADX_PUBLIC_URL + /api/auth/callback; register exactly that
# redirect URI on the provider. The group name is the one in the groups claim.
ADX_PUBLIC_URL=https://adx.example.com
ADX_OIDC_CLIENT_ID=
ADX_OIDC_CLIENT_SECRET=
ADX_AUTHENTIK_GROUP_NAME=adx-users
